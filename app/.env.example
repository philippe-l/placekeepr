# Réseau Solana : devnet | testnet | mainnet-beta (devnet pendant la phase d'apprentissage)
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# RPC custom optionnel (ex: Helius devnet). Sinon, RPC public du réseau.
# EXPO_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=...

# Arbre de Merkle Bubblegum pour les mints cNFT (sortie de scripts/create-tree.ts)
# EXPO_PUBLIC_MERKLE_TREE=

# Programme place_registry (program/) — unicité on-chain des lieux.
# Absent = mint sans registre (mode dégradé).
# EXPO_PUBLIC_PLACE_REGISTRY_PROGRAM=EXB4PeyChBveaChFW5nGTqJ2DmNp292cRFo4Ks1aC9pU

# Pubkey du vérifieur GPS (secret détenu par l'API, route /verify-capture).
# Requis avec le registre : le programme exige sa co-signature.
# EXPO_PUBLIC_PLACE_VERIFIER=aakwLi7T1AYp1pGVqhtUG4K9HRneWWD5K1zLCaQpEnA

# API PlaceKeepr (server/) : miroir du journal des mints, photos de preuve,
# co-signature du vérifieur. Absente = mode local pur, la sync est inactive.
# EXPO_PUBLIC_API_URL=https://placekeepr.app
