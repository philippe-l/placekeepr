{
  "expo": {
    "name": "PlaceKeepr",
    "slug": "placekeepr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "placekeepr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08080f"
      },
      "package": "com.placekeepr.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080f",
          "dark": {
            "backgroundColor": "#08080f",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlaceKeepr utilise votre position pour vérifier que vous êtes bien sur place avant de minter un lieu."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "PlaceKeepr utilise l'appareil photo pour photographier le lieu que vous mintez."
        }
      ],
      "expo-localization",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
