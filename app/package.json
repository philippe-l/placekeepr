{
  "name": "placekeepr",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "start": "expo start",
    "web": "expo start --web",
    "create-tree": "tsx scripts/create-tree.ts",
    "build:map-style": "node scripts/build-map-style.mjs && prettier --write assets/map-styles/retro-dark.json",
    "build:icons": "node scripts/build-app-icons.mjs",
    "set-treasury": "tsx scripts/set-treasury.ts",
    "deposit-royalty": "tsx scripts/deposit-royalty.ts",
    "replay-helius-tx": "tsx scripts/replay-helius-tx.ts",
    "remove-places": "tsx scripts/remove-places.ts"
  },
  "displayName": "PlaceKeepr",
  "description": "Proof-of-location cNFT app on Solana (Seeker) — mint places, become their keeper.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-web3js"
  ],
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [],
        "listUnknownPackages": false
      }
    }
  },
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^11.3.4",
    "@metaplex-foundation/mpl-bubblegum": "^5.0.2",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.85.5",
    "@wallet-ui/react-native-web3js": "^4.0.1",
    "expo": "~55.0.23",
    "expo-blur": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.18",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "^55.0.6",
    "expo-image-manipulator": "~55.0.17",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.9",
    "expo-linking": "~55.0.8",
    "expo-localization": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "i18next": "^26.3.1",
    "jpeg-js": "^0.4.4",
    "js-base64": "^3.7.8",
    "pako": "^2.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-quick-crypto": "^1.0.6",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.1",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "react-qr-code": "^2.0.16"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.2.14",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~55.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "private": true
}
