# ── Base ────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-moi
DATABASE_URL=postgres://placekeepr:change-moi@db:5432/placekeepr

# ── API ─────────────────────────────────────────────────────────────────────
PORT=8787
# Répertoire d'écriture des assets (volume Docker, servi par l'API).
ASSETS_DIR=/data/assets
# Base publique des assets. DOIT être un domaine que tu possèdes : elle part
# dans les métadonnées cNFT, qui sont gravées on-chain et non réécrivables.
PUBLIC_ASSET_BASE_URL=https://placekeepr.app/assets
# Note : pas de SITE_ADDRESS ici — le TLS et le domaine sont gérés par le
# nginx partagé de la stack baladezen, pas par cette stack.
MAX_ASSET_BYTES=8388608
# Sous ce seuil d’espace libre (10 Gio), l’API refuse tout upload en 507 :
# le disque est celui de BaladeZen, mieux vaut refuser que le remplir.
MIN_FREE_DISK_BYTES=10737418240

# ── Chaîne ──────────────────────────────────────────────────────────────────
PLACE_REGISTRY_PROGRAM=EXB4PeyChBveaChFW5nGTqJ2DmNp292cRFo4Ks1aC9pU
# Arbre Bubblegum PRIVÉ dont le vérifieur est délégué (#40) — le même que
# EXPO_PUBLIC_MERKLE_TREE côté app. Absent : aucune capture co-signée (503).
MERKLE_TREE=
# Cluster attribué aux mints découverts par l'indexer (sans contexte client).
CLUSTER=devnet
# RPC de ce même cluster : POST /mints y relit la transaction avant d’écrire.
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Secrets (jamais commités) ───────────────────────────────────────────────
# Keypair du vérifieur GPS, tableau JSON de 64 octets. Cette clé est TOUT ce
# qui rend la vérif incontournable : fichier en 600, jamais dans le compose.
# Rotation possible via `set_verifier` (admin du programme).
VERIFIER_KEYPAIR=
# Secret partagé avec Helius (= authHeader du webhook).
HELIUS_WEBHOOK_SECRET=
